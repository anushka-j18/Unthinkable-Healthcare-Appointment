{
  "name": "healthcare-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:auth": "ts-node scripts/test-auth.ts",
    "test:admin": "ts-node scripts/test-admin.ts",
    "test:concurrency": "ts-node scripts/test-booking-concurrency.ts",
    "test:symptoms": "ts-node scripts/test-symptom-llm.ts",
    "test:postvisit": "ts-node scripts/test-postvisit-llm.ts",
    "test:email": "ts-node scripts/test-email-notifications.ts",
    "test:worker": "ts-node scripts/test-bullmq-worker.ts",
    "test:google": "ts-node scripts/test-google-calendar.ts",
    "test:patient": "ts-node scripts/test-patient-ui-flow.ts",
    "dev:worker": "ts-node src/workers/queue.worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
