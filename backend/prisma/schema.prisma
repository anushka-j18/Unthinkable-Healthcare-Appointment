// Prisma Schema for Healthcare Appointment & Follow-up Manager

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// User Roles in the Healthcare Platform
enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

/// Appointment Lifecycle Statuses
enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

/// AI Urgency Classification Levels
enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Medication Reminder Dispatch Statuses
enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

/// System Notification Types
enum NotificationType {
  BOOKING_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  MEDICATION_REMINDER
  LEAVE_CANCELLATION
}

/// Delivery Channels for Notifications
enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

/// Notification Delivery Statuses
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Core User entity representing Patients, Doctors, and Administrators
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Role-Specific Profile
  doctorProfile DoctorProfile?

  // Relations
  patientAppointments Appointment[]        @relation("PatientAppointments")
  medicationReminders MedicationReminder[]
  notificationLogs    NotificationLog[]

  @@index([email])
  @@index([role])
}

/// Doctor Profile containing specialisation, working hours, and slot duration
model DoctorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation      String
  slotDurationMinutes Int      @default(30)
  workingHours        Json // Structured day-by-day availability (e.g. { "monday": { "start": "09:00", "end": "17:00" }, ... })
  bio                 String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  leaveDays          LeaveDay[]
  doctorAppointments Appointment[] @relation("DoctorAppointments")

  @@index([specialisation])
}

/// Doctor Scheduled Leave Days
model LeaveDay {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  reason    String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Prevent duplicate leave entries for the same doctor on the same date
  @@unique([doctorId, date])
  @@index([doctorId, date])
}

/// Appointment Entity representing a scheduled consultation slot
model Appointment {
  id                 String            @id @default(uuid())
  doctorId           String
  doctor             DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId          String
  patient            User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  slotStartTime      DateTime
  slotEndTime        DateTime
  status             AppointmentStatus @default(BOOKED)
  googleEventId      String?
  cancellationReason String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Associated Clinical Records
  symptomForm         SymptomForm?
  postVisitNote       PostVisitNote?
  medicationReminders MedicationReminder[]
  notificationLogs    NotificationLog[]

  // Database-Level Concurrency Lock: Strictly prevents double-booking for the same doctor at the same start time
  @@unique([doctorId, slotStartTime])
  @@index([doctorId, slotStartTime])
  @@index([patientId, slotStartTime])
  @@index([status])
}

/// Patient Pre-Visit Symptom Form & AI-Generated Intake Analysis
model SymptomForm {
  id                 String        @id @default(uuid())
  appointmentId      String        @unique
  appointment        Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rawSymptoms        String        @db.Text
  urgencyLevel       UrgencyLevel?
  chiefComplaint     String?       @db.Text
  suggestedQuestions Json? // Array of 3 AI-generated questions for the doctor (e.g. ["Question 1", ...])
  llmProcessedAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

/// Doctor Post-Visit Clinical Note, Prescription, & AI Patient Summary
model PostVisitNote {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorNotes    String      @db.Text
  prescription   Json? // Structured medications list: [{ "name": "...", "dosage": "...", "frequency": "...", "durationDays": 7 }]
  patientSummary String?     @db.Text // AI-generated patient friendly explanation
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/// Medication Schedule Reminder for Patients
model MedicationReminder {
  id             String         @id @default(uuid())
  appointmentId  String
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        User           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  frequency      String
  reminderTime   DateTime // Scheduled execution timestamp
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Index for high-performance background queue worker polling
  @@index([status, reminderTime])
}

/// Notification Execution & Retry Audit Log
model NotificationLog {
  id             String              @id @default(uuid())
  recipientId    String?
  recipient      User?               @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail String
  type           NotificationType
  channel        NotificationChannel @default(EMAIL)
  status         NotificationStatus  @default(PENDING)
  retryCount     Int                 @default(0)
  errorMessage   String?             @db.Text
  appointmentId  String?
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Index for email retry background jobs
  @@index([status, retryCount])
}
